<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 색 토큰 (docs/DESIGN.md §2) — UDInspect · LaVis · 브라우저판 css/style.css 와 같은 뿌리 -->

    <!-- 글자 -->
    <SolidColorBrush x:Key="InkBrush" Color="#1F2A37"/>          <!-- 본문 글자 -->
    <SolidColorBrush x:Key="Ink2Brush" Color="#4B5563"/>
    <SolidColorBrush x:Key="Ink3Brush" Color="#6B7280"/>         <!-- 힌트 -->

    <!-- 바탕 -->
    <SolidColorBrush x:Key="GroundBrush" Color="#FFFFFF"/>       <!-- 카드/입력 배경 -->
    <SolidColorBrush x:Key="PaperBrush" Color="#F4F6F9"/>        <!-- 패널 -->
    <SolidColorBrush x:Key="Paper2Brush" Color="#E9EEF4"/>       <!-- 헤더/탭 -->

    <!-- 선 -->
    <SolidColorBrush x:Key="LineBrush" Color="#CCD3DB"/>         <!-- 테두리 -->
    <SolidColorBrush x:Key="Line2Brush" Color="#E2E7ED"/>        <!-- 격자선 -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#DDDDDD"/>     <!-- DataGrid -->

    <!-- 강조 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1A6FB5"/>       <!-- 주 버튼·선택·링크 -->
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#1A5276"/>   <!-- 강조 글자 -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3EEF8"/>   <!-- 선택 배경 -->

    <!-- 합격/완료 -->
    <SolidColorBrush x:Key="PassBrush" Color="#2E9E5B"/>
    <SolidColorBrush x:Key="PassFillBrush" Color="#D7EFD7"/>

    <!-- 오류 -->
    <SolidColorBrush x:Key="FailBrush" Color="#9C0006"/>         <!-- 오류 글자 -->
    <SolidColorBrush x:Key="FailFillBrush" Color="#FFC7CE"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D9534F"/>       <!-- 파괴적 버튼 -->
    <SolidColorBrush x:Key="ErrorStatusBrush" Color="#B01E1E"/>  <!-- 상태줄 오류 -->

    <!-- 경고 -->
    <SolidColorBrush x:Key="WarnBrush" Color="#9A5B00"/>         <!-- 경고 글자 -->
    <SolidColorBrush x:Key="WarnFillBrush" Color="#FFF4D6"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="#E0B25A"/>

    <!-- 주의·BSC -->
    <SolidColorBrush x:Key="OrangeBrush" Color="#E67E00"/>       <!-- BSC 표시·강조 숫자 -->
    <SolidColorBrush x:Key="CautionBrush" Color="#F0AD4E"/>      <!-- 주의 버튼 -->

    <!-- 캔버스 -->
    <SolidColorBrush x:Key="CanvasBgBrush" Color="#8A97A6"/>     <!-- 캔버스 바탕 -->
    <SolidColorBrush x:Key="CanvasEdgeBrush" Color="#4B5563"/>   <!-- 라벨 외곽 -->
    <SolidColorBrush x:Key="SnapGuideBrush" Color="#E0218A"/>    <!-- 스냅 안내선 -->

    <!-- 오버레이 (캔버스 위 좌표 표시·토스트) -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC1F2A37"/>

    <!-- 기본 위젯 (DESIGN.md §3) — 글꼴은 지정하지 않는다 (시스템 Segoe UI / 맑은 고딕) -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="2,3"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Margin" Value="2"/>
    </Style>

    <!-- 글자 보조 스타일: 힌트 11 · 부제/칩 12 · 레전드 -->
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Mini" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="Ovl" TargetType="TextBlock">
        <Setter Property="Background" Value="{StaticResource OverlayBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- 평평한 버튼 템플릿 (변형 버튼·툴바 토글이 공유) -->
    <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="FlatToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 버튼 변형: PRIMARY / DANGER(파괴적, 오른쪽 끝 24px 분리) / CAUTION / GHOST / SMALL -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="24,2,2,2"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>
    <!-- 이전 이름 호환 -->
    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource DangerButton}"/>
    <Style x:Key="CautionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource CautionBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CautionBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Paper2Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Background" Value="{StaticResource GroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>
    <Style x:Key="SmallGhostButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="SmallDangerButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
    </Style>
    <!-- 툴바 토글 (스냅·격자·눈금·링크 보기·굵게·기울임) -->
    <Style x:Key="ToolToggle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Background" Value="{StaticResource GroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Template" Value="{StaticResource FlatToggleTemplate}"/>
    </Style>

    <!-- 앱바 상태 칩 (●DB ●이미지 ●저장폴더) -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MaxWidth" Value="220"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource GroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GBox: GroupBox 대용 (Border + 레전드). Header 에 문자열이나 패널을 넣는다 -->
    <Style x:Key="GBox" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Background" Value="{StaticResource GroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,6,8,8" SnapsToDevicePixels="True">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,6"
                                              TextBlock.FontWeight="Bold" TextBlock.FontSize="12"
                                              TextBlock.Foreground="{StaticResource Ink2Brush}"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 레전드 부제 (".legend .sub") -->
    <Style x:Key="LegendSub" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 인스펙터 탭 -->
    <Style x:Key="InspTabs" TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource GroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- 데이터그리드: 본문 13, 행 높이 24, 격자선 #DDDDDD -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="RowHeight" Value="24"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="Background" Value="{StaticResource GroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</ResourceDictionary>
