<Window x:Class="LaPrint.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="1000" Height="820" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PaperBrush}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 왼쪽 탐색: 폴더 경로 · 데이터 매칭 · 라벨/용지 · 출력 · ZEBRA 프린터 · 이미지 · 검증 규칙 · 화면 · 출력 이력 · 정보 -->
        <ListBox x:Name="nav" Grid.Column="0" Grid.Row="0" Margin="0,0,10,0" FontSize="13"
                 Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource LineBrush}"
                 DisplayMemberPath="Title" SelectedValuePath="Key"
                 SelectionChanged="OnNavSelectionChanged"/>

        <!-- 오른쪽: 선택한 페이지 -->
        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource GroundBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <ContentControl x:Name="pageHost"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnClose" Content="닫기" MinWidth="84" IsDefault="True" IsCancel="True"
                    Style="{StaticResource PrimaryButton}" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
