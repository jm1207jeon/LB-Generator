<Window x:Class="LaPrint.App.Windows.MapperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="데이터 매칭 편집" Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PaperBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="fieldsCol" Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="hintText" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,8"
                   Text="왼쪽에서 항목을 고른 뒤 오른쪽 표에서 열을 클릭하면 지정됩니다. 열 문자를 직접 입력해도 됩니다."/>

        <!-- 좌: 항목 (그룹별) — 매핑 모드에서만 -->
        <Border x:Name="fieldsPane" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Background="{StaticResource GroundBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,0">
                    <TextBlock Text="조회 키" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Ink3Brush}"
                               Background="{StaticResource PaperBrush}" Padding="7,4" Margin="0,0,0,2"/>
                    <Border x:Name="keyRow" CornerRadius="5" Padding="6,3" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="OnKeyRowClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="품목번호 (조회 키)" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBox Grid.Column="1" x:Name="inpKeyCol" Width="46" MaxLength="3" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                     TextAlignment="Center" CharacterCasing="Upper" Margin="3,0" Padding="1,2"
                                     TextChanged="OnKeyColChanged" GotKeyboardFocus="OnKeyColFocus"/>
                            <TextBlock Grid.Column="2" x:Name="keyColSample" FontSize="11" Foreground="{StaticResource Ink2Brush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="fieldsList" Margin="4"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 우: 라벨DB 표 (열 문자·머리글·셀 클릭 = 지정) -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <Border x:Name="chosenBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="9,6" CornerRadius="6" Visibility="Collapsed"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="Transparent">
                <TextBlock x:Name="chosenText" FontSize="12" Foreground="{StaticResource Ink3Brush}" Text="아직 고르지 않았습니다."/>
            </Border>
            <TextBlock x:Name="footText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            <Border Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 고정 첫 열 (열 / 머리글 / 선택 품목 / 예시 n) -->
                    <Grid x:Name="gridLabels" Grid.Column="0"/>
                    <ScrollViewer x:Name="gridScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="grid"/>
                    </ScrollViewer>
                    <TextBlock x:Name="gridEmpty" Grid.ColumnSpan="2" Visibility="Collapsed" TextAlignment="Center" Margin="24,40"
                               FontSize="12.5" LineHeight="22" Foreground="{StaticResource Ink3Brush}">
                        <Run Text="라벨DB를 먼저 불러오세요."/><LineBreak/>
                        <Run Text="설정 › 폴더 경로에서 DB를 지정하거나 샘플 데이터를 불러올 수 있습니다."/>
                    </TextBlock>
                </Grid>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnReset" Content="기본값으로" Style="{StaticResource GhostButton}" MinWidth="84" Click="OnResetClick"/>
            <Button x:Name="btnCancel" Content="취소" MinWidth="84" IsCancel="True" IsDefault="True" Click="OnCancelClick"/>
            <Button x:Name="btnOk" Content="저장" MinWidth="84" Style="{StaticResource PrimaryButton}" Click="OnOkClick"/>
        </StackPanel>
    </Grid>
</Window>
