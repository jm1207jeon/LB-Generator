<Window x:Class="LaPrint.App.Windows.MapperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="데이터 매칭 편집" Width="1100" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PaperBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="hintText" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="왼쪽에서 항목을 고른 뒤 오른쪽 표에서 열을 클릭하면 지정됩니다. 열 문자를 직접 입력해도 됩니다."/>

        <!-- 좌: 항목 (그룹별) — 매핑 모드에서만 -->
        <Border x:Name="fieldsPane" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Background="{StaticResource GroundBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                    <TextBlock Text="품목번호 열" Style="{StaticResource Mini}" Width="80"/>
                    <TextBox x:Name="inpKeyCol" Width="60" FontFamily="Consolas" TextChanged="OnKeyColChanged"/>
                    <TextBlock x:Name="keyColSample" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="fieldsList" Margin="4"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 우: 라벨DB 표 (열 머리글 클릭 = 지정) -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <TextBlock x:Name="chosenText" DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="13" Foreground="{StaticResource AccentDeepBrush}"/>
            <DataGrid x:Name="grid" IsReadOnly="True" SelectionUnit="Cell" FrozenColumnCount="1"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PreviewMouseLeftButtonUp="OnGridClick"/>
        </DockPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnReset" Content="기본값으로" Style="{StaticResource GhostButton}" MinWidth="84" Click="OnResetClick"/>
            <Button x:Name="btnCancel" Content="취소" MinWidth="84" IsCancel="True" IsDefault="True" Click="OnCancelClick"/>
            <Button x:Name="btnOk" Content="적용" MinWidth="84" Style="{StaticResource PrimaryButton}" Click="OnOkClick"/>
        </StackPanel>
    </Grid>
</Window>
